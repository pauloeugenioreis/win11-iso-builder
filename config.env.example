# Copie para config.env e ajuste. config.env não é versionado (contém a chave).
# As opções de linha de comando têm precedência sobre este arquivo.

# Chave do produto (obrigatória)
PRODUCT_KEY="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"

# EditionID do install.wim (Professional, Core, Education, ProfessionalWorkstation...)
EDITION="Professional"

# Conta local de administrador criada pelo autounattend.xml
LOCAL_USER="Usuario"
LOCAL_PASSWORD=""

# Pasta onde as ISOs geradas são gravadas (vazio = mesma pasta da ISO original)
OUTPUT_DIR=""
